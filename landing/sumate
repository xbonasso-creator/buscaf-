<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Sumate a Buscafé</title>
  <meta name="description" content="Registrá tu cafetería o potenciá tu presencia en Buscafé con nuestros servicios á la carte." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;0,9..40,800;0,9..40,900&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --espresso:   #2A1608;
      --heading:    #4A2D2A;
      --accent:     #C2542A;
      --error:      #D94040;
      --success:    #1A7A46;
      --bg:         #FBF6EE;
      --bg-warm:    #F1E4D0;
      --field-bg:   #FBF8F4;
      --white:      #FFFFFF;
      --text:       #2A1608;
      --text-light: #8A7360;
      --border:     #E5D6C0;
      --radius:     16px;
      --radius-sm:  10px;
      --radius-pill:50px;
      --shadow-md:  0 4px 20px rgba(42,22,8,.12);
      --font: 'DM Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    }
    html { scroll-behavior: smooth; }
    body { font-family: var(--font); background: var(--bg); color: var(--text); min-height: 100vh; }

    nav {
      position: sticky; top: 0; z-index: 100;
      background: rgba(251,246,238,.92);
      backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--border);
      padding: 0 24px;
    }
    .nav-inner { max-width: 1100px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; height: 64px; }
    .nav-logo { display: flex; align-items: center; gap: 10px; text-decoration: none; }
    .nav-logo img { width: 36px; height: 36px; border-radius: 10px; object-fit: cover; }
    .nav-logo span { font-size: 18px; font-weight: 800; color: var(--espresso); letter-spacing: -.3px; }
    .nav-back { display: inline-flex; align-items: center; gap: 6px; color: var(--text-light); text-decoration: none; font-size: 14px; font-weight: 500; transition: color .2s; }
    .nav-back:hover { color: var(--espresso); }

    .hero {
      max-width: 800px; margin: 0 auto;
      padding: 56px 24px 40px;
      text-align: center;
    }
    .hero-eyebrow {
      display: inline-flex; align-items: center; gap: 8px;
      font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase;
      color: var(--accent); margin-bottom: 18px;
    }
    .hero h1 {
      font-size: clamp(30px, 5vw, 46px);
      font-weight: 900; letter-spacing: -1px; line-height: 1.15;
      color: var(--heading); margin-bottom: 16px;
    }
    .hero p {
      font-size: 17px; color: var(--text-light); line-height: 1.65;
      max-width: 560px; margin: 0 auto;
    }

    .path-single {
      max-width: 1000px; margin: 0 auto;
      padding: 8px 24px 64px;
    }
    .path-single-grid {
      display: grid; grid-template-columns: 1fr 1fr;
      align-items: center; gap: 48px;
    }
    .path-single-card {
      background: var(--white); border: 2px solid var(--border);
      border-radius: var(--radius); padding: 48px 40px;
      text-align: left;
      display: flex; flex-direction: column; align-items: flex-start; gap: 18px;
      transition: border-color .2s, box-shadow .2s;
    }
    .path-single-card:hover { border-color: var(--accent); box-shadow: var(--shadow-md); }
    .path-single-icon {
      width: 68px; height: 68px; border-radius: 18px;
      background: var(--bg-warm);
      display: flex; align-items: center; justify-content: center;
      font-size: 32px;
    }
    .path-single-card h2 { font-size: 26px; font-weight: 900; color: var(--heading); letter-spacing: -.5px; }
    .path-single-card p { font-size: 15.5px; color: var(--text-light); line-height: 1.6; max-width: 460px; }
    .path-single-btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      padding: 18px 40px; border-radius: var(--radius-pill);
      font-size: 16px; font-weight: 700; text-decoration: none;
      background: var(--espresso); color: #fff;
      box-shadow: var(--shadow-md);
      transition: opacity .2s, transform .15s;
      margin-top: 4px;
    }
    .path-single-btn:hover { opacity: .88; transform: translateY(-1px); }
    .path-single-preview {
      display: flex; align-items: center; justify-content: center;
    }
    .path-single-preview img {
      width: 100%; max-width: 320px; height: auto;
      border-radius: 28px;
      box-shadow: 0 20px 60px rgba(42,22,8,.18);
    }
    @media (max-width: 720px) {
      .path-single-grid { grid-template-columns: 1fr; }
      .path-single-preview { order: -1; }
      .path-single-preview img { max-width: 240px; }
      .path-single-card { text-align: center; align-items: center; }
    }

    .section-title-wrap {
      max-width: 800px; margin: 0 auto;
      padding: 40px 24px 8px; text-align: center;
    }
    .section-title-wrap p { font-size: 19px; font-weight: 700; color: var(--heading); line-height: 1.5; max-width: 520px; margin: 0 auto; }

    .services-wrap { max-width: 800px; margin: 0 auto; padding: 32px 24px 40px; }
    .service-item {
      display: flex; align-items: flex-start; gap: 16px;
      background: var(--white); border: 1.5px solid var(--border);
      border-radius: var(--radius-sm); padding: 18px 20px;
      margin-bottom: 12px; cursor: pointer;
      transition: border-color .15s, background .15s;
    }
    .service-item:hover { border-color: #c9a07a; }
    .service-item.checked { border-color: var(--espresso); background: var(--bg-warm); }
    .service-checkbox {
      flex-shrink: 0; width: 22px; height: 22px; border-radius: 6px;
      border: 2px solid var(--border); background: var(--white);
      display: flex; align-items: center; justify-content: center;
      margin-top: 2px; transition: all .15s;
    }
    .service-item.checked .service-checkbox { background: var(--espresso); border-color: var(--espresso); }
    .service-checkbox svg { width: 13px; height: 13px; opacity: 0; transition: opacity .15s; }
    .service-item.checked .service-checkbox svg { opacity: 1; }
    .service-body { flex: 1; }
    .service-top { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; margin-bottom: 4px; }
    .service-name { font-size: 15.5px; font-weight: 700; color: var(--heading); }
    .service-price { font-size: 16px; font-weight: 800; color: var(--accent); white-space: nowrap; }
    .service-desc { font-size: 13px; color: var(--text-light); line-height: 1.55; }
    .service-item input[type="checkbox"] { display: none; }

    .cart-summary {
      position: sticky; bottom: 0; left: 0; right: 0;
      background: var(--espresso); border-radius: var(--radius) var(--radius) 0 0;
      padding: 20px 24px; margin-top: 24px;
      display: flex; align-items: center; justify-content: space-between; gap: 16px;
      box-shadow: 0 -8px 30px rgba(42,22,8,.25);
      flex-wrap: wrap;
    }
    .cart-info { color: #fff; }
    .cart-count { font-size: 12px; color: rgba(255,255,255,.6); text-transform: uppercase; letter-spacing: .06em; font-weight: 700; margin-bottom: 2px; }
    .cart-total { font-size: 24px; font-weight: 900; }
    .cart-total span { font-size: 14px; font-weight: 500; opacity: .6; }
    .cart-btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      padding: 15px 30px; border-radius: var(--radius-pill);
      background: var(--accent); color: #fff; border: none;
      font-size: 14.5px; font-weight: 700; font-family: inherit; cursor: pointer;
      transition: opacity .2s, transform .15s; white-space: nowrap;
    }
    .cart-btn:hover:not(:disabled) { opacity: .9; transform: translateY(-1px); }
    .cart-btn:disabled { opacity: .35; cursor: not-allowed; }

    .modal-overlay {
      display: none; position: fixed; inset: 0; z-index: 200;
      background: rgba(42,22,8,.55); backdrop-filter: blur(3px);
      align-items: center; justify-content: center; padding: 20px;
    }
    .modal-overlay.show { display: flex; }
    .modal-box {
      background: var(--white); border-radius: var(--radius);
      max-width: 440px; width: 100%; padding: 32px;
      box-shadow: 0 20px 60px rgba(42,22,8,.3);
      position: relative;
    }
    .modal-icon {
      width: 56px; height: 56px; border-radius: 16px; background: var(--bg-warm);
      display: flex; align-items: center; justify-content: center; font-size: 26px; margin-bottom: 18px;
    }
    .modal-box h3 { font-size: 20px; font-weight: 900; color: var(--heading); margin-bottom: 10px; letter-spacing: -.3px; }
    .modal-box p { font-size: 14px; color: var(--text-light); line-height: 1.6; margin-bottom: 20px; }
    .modal-summary {
      background: var(--field-bg); border: 1px solid var(--border); border-radius: var(--radius-sm);
      padding: 14px 16px; margin-bottom: 20px; font-size: 13px; color: var(--text); line-height: 1.7;
    }
    .modal-summary strong { color: var(--heading); }
    .modal-actions { display: flex; flex-direction: column; gap: 10px; }
    .modal-btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      padding: 14px 20px; border-radius: var(--radius-pill);
      font-size: 14px; font-weight: 700; text-decoration: none; font-family: inherit;
      cursor: pointer; border: none; transition: opacity .2s;
    }
    .modal-btn--primary { background: #25D366; color: #fff; }
    .modal-btn--primary:hover { opacity: .88; }
    .modal-btn--secondary { background: var(--field-bg); color: var(--espresso); border: 1.5px solid var(--border); }
    .modal-btn--secondary:hover { background: var(--bg-warm); }
    .modal-close {
      position: absolute; top: 16px; right: 16px;
      width: 32px; height: 32px; border-radius: 50%;
      background: var(--field-bg); border: none; cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      color: var(--text-light); font-size: 16px; transition: background .15s;
    }
    .modal-close:hover { background: var(--bg-warm); }

    .mini-note {
      max-width: 800px; margin: 0 auto; padding: 0 24px 60px;
      text-align: center;
    }
    .mini-note p { font-size: 13px; color: var(--text-light); line-height: 1.6; }
    .mini-note a { color: var(--accent); text-decoration: none; font-weight: 600; }

    footer { border-top: 1px solid var(--border); padding: 32px 24px; }
    .footer-inner { max-width: 1100px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; }
    .footer-copy { font-size: 13px; color: var(--text-light); }
    .footer-links { display: flex; gap: 24px; flex-wrap: wrap; }
    .footer-links a { font-size: 13px; color: var(--text-light); text-decoration: none; transition: color .2s; }
    .footer-links a:hover { color: var(--espresso); }

    @media (max-width: 640px) {
      .paths { grid-template-columns: 1fr; }
      .cart-summary { flex-direction: column; align-items: stretch; text-align: center; }
      .cart-btn { width: 100%; }
      .service-top { flex-direction: column; gap: 2px; }
    }
  </style>
</head>
<body>

<nav>
  <div class="nav-inner">
