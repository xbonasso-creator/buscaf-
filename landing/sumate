<script>
  const items = document.querySelectorAll('.service-item');
  const cartCount = document.getElementById('cart-count');
  const cartTotalNum = document.getElementById('cart-total-num');
  const cartBtn = document.getElementById('cart-btn');
  const modalOverlay = document.getElementById('modal-overlay');
  const modalClose = document.getElementById('modal-close');
  const modalSummary = document.getElementById('modal-summary');
  const modalWhatsapp = document.getElementById('modal-whatsapp');
  const modalEmail = document.getElementById('modal-email');

  const WHATSAPP_NUMBER = '59800000000';
  const EMAIL = 'info@buscafe.app';

  function updateCart() {
    let total = 0;
    let count = 0;
    let selected = [];
    items.forEach(item => {
      const checkbox = item.querySelector('input[type="checkbox"]');
      if (checkbox.checked) {
        total += parseInt(item.dataset.price, 10);
        count++;
        selected.push({
          name: item.querySelector('.service-name').textContent,
          price: item.dataset.price,
        });
      }
    });
    cartCount.textContent = count === 0
      ? '0 servicios seleccionados'
      : `${count} servicio${count !== 1 ? 's' : ''} seleccionado${count !== 1 ? 's' : ''}`;
    cartTotalNum.textContent = total;
    cartBtn.disabled = count === 0;
    return selected;
  }

  items.forEach(item => {
    const checkbox = item.querySelector('input[type="checkbox"]');
    item.addEventListener('click', e => {
      e.preventDefault();
      checkbox.checked = !checkbox.checked;
      item.classList.toggle('checked', checkbox.checked);
      updateCart();
    });
  });

  cartBtn.addEventListener('click', () => {
    const selected = updateCart();
    if (selected.length === 0) return;

    let total = selected.reduce((s, i) => s + parseInt(i.price, 10), 0);
    let summaryHTML = '<strong>Tu selección:</strong><br>';
    selected.forEach(s => { summaryHTML += `• ${s.name} — USD ${s.price}<br>`; });
    summaryHTML += `<br><strong>Total: USD ${total}</strong>`;
    modalSummary.innerHTML = summaryHTML;

    let waText = `Hola! Quiero contratar estos servicios de Buscafé:%0A%0A`;
    selected.forEach(s => { waText += `• ${s.name} — USD ${s.price}%0A`; });
    waText += `%0ATotal: USD ${total}`;
    modalWhatsapp.href = `https://wa.me/${WHATSAPP_NUMBER}?text=${waText}`;

    let mailBody = `Hola,%0D%0A%0D%0AQuiero contratar estos servicios de Buscafé:%0D%0A%0D%0A`;
    selected.forEach(s => { mailBody += `- ${s.name} — USD ${s.price}%0D%0A`; });
    mailBody += `%0D%0ATotal: USD ${total}`;
    modalEmail.href = `mailto:${EMAIL}?subject=Contratación de servicios Buscafé&body=${mailBody}`;

    modalOverlay.classList.add('show');
  });

  modalClose.addEventListener('click', () => modalOverlay.classList.remove('show'));
  modalOverlay.addEventListener('click', e => {
    if (e.target === modalOverlay) modalOverlay.classList.remove('show');
  });
</script>

</body>
</html>
