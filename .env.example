# Copiá este archivo a .env.local y completá con tus valores reales.
# .env.local NUNCA se sube a Git (ver .gitignore).

# Token público (pk.) de Mapbox — se embebe en el bundle de la app.
# Crear/ver en https://console.mapbox.com/account/access-tokens/
EXPO_PUBLIC_MAPBOX_TOKEN=

# Token secreto (sk.) de Mapbox con scope "Downloads:Read", usado solo
# durante el build nativo para descargar el SDK de Mapbox. NO se embebe
# en la app. Para builds en la nube, configurar como EAS secret en vez
# de (o además de) este .env.local.
RNMAPBOX_DOWNLOAD_TOKEN=
